# Required for front page content. Never prefix secrets with VITE_.
DATABASE_URL=postgres://palianytsia:palianytsia_local@localhost:5432/palianytsia
API_PORT=3001
# Set a private password used to sign in at /admin.
ADMIN_PASSWORD=
# Optional, for servers: build the frontend straight into the folder nginx serves.
# That folder is emptied on every build. Leave unset to build into ./dist.
# BUILD_OUT_DIR=/var/www/palianytsia/dist

# Contact form email, sent through Mailtrap (https://mailtrap.io). The form is disabled until the
# first three are set.
CONTACT_TO_EMAIL=palianytsiabread@gmail.com
# API token from Mailtrap: Sending Domains > your domain > API token. Keep it secret.
MAILTRAP_API_TOKEN=
# Sender address on a domain verified in Mailtrap, for example contact@palianytsiabread.com.
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=Palianytsia Bread website
# Development only: send to a Mailtrap testing inbox instead of the real recipient. Use the inbox ID
# from its URL, and an API token that has access to that inbox.
# MAILTRAP_INBOX_ID=

# Payments through Square Payment Links (https://developer.squareup.com). Pay is disabled until the first
# three are set. See "Payments with Square" in the README for the dashboard setup.
# "sandbox" (test money, the default) or "production" (real cards). Anything but the exact word "production" is the sandbox.
SQUARE_ENVIRONMENT=sandbox
# Access token and location ID from your Square application. Use the sandbox ones while testing. Keep the token secret.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# The public address of the site, no trailing slash: customers are sent back to ${SITE_URL}/order/<reference> after paying.
SITE_URL=https://palianytsiabread.com
# For the webhook (Square's message that a payment happened). Without these two, payments are never marked paid.
# The signature key is shown for the webhook subscription in the Square dashboard. The URL must be EXACTLY the
# notification URL entered there.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://palianytsiabread.com/api/square/webhook

# Server Health tab (admin): the SSL certificate is checked by connecting to SITE_URL over HTTPS, the way a visitor
# would, which needs no special permissions. Only set this to read a certificate file instead (it must be readable
# by the user running the API; Let's Encrypt's own files are root-only).
# SSL_CERT_PATH=
