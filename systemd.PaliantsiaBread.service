[Unit]
Description=Paliantsia Bread Bun App
After=network.target

[Service]
Type=simple
User=cardify
WorkingDirectory=/home/cardify/PaliantsiaBread
Environment=NODE_ENV=production
Environment=PORT=3000
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/cardify/.bun/bin/bun dev
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=20

# Optional local environment overrides
# EnvironmentFile=/home/cardify/PaliantsiaBread/.env

[Install]
WantedBy=multi-user.target
