server {
    listen 38419;
    root /var/www/palianytsia/dist;

    location /api/ {
        proxy_pass http://127.0.0.1:38417;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        client_max_body_size 12m;
    }

    location / {
        try_files $uri /index.html;
    }
}