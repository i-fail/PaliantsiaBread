{
  "name": "palianytsia-bread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n web,api -c yellow,cyan \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "bun --watch server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:api": "bun server/index.ts",
    "db:check": "bun server/check-db.ts",
    "db:migrate": "bun server/migrate.ts",
    "db:create": "bun server/create-db.ts",
    "test": "bun test server",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.0",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.8",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.0"
  }
}
